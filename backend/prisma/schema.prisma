generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                  String   @id @default(cuid())
  name                String
  category            String
  unit                String
  minThreshold        Decimal  @default(0) @db.Decimal(12, 2)
  currentStock        Decimal  @default(0) @db.Decimal(12, 2)
  defaultBuyingPrice  Decimal  @default(0) @db.Decimal(12, 2)
  defaultSellingPrice Decimal  @default(0) @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchases StockPurchase[]
  sales     Sale[]

  @@index([name])
  @@index([category])
}

model StockPurchase {
  id              String   @id @default(cuid())
  productId       String
  quantity        Decimal  @db.Decimal(12, 2)
  unitBuyingPrice Decimal  @db.Decimal(12, 2)
  totalCost       Decimal  @db.Decimal(14, 2)
  supplierName    String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([date])
}

model Sale {
  id                    String   @id @default(cuid())
  productId             String
  quantity              Decimal  @db.Decimal(12, 2)
  unitSellingPrice      Decimal  @db.Decimal(12, 2)
  unitBuyingPriceAtSale Decimal  @db.Decimal(12, 2)
  totalRevenue          Decimal  @db.Decimal(14, 2)
  totalCost             Decimal  @db.Decimal(14, 2)
  profit                Decimal  @db.Decimal(14, 2)
  customerName          String?
  date                  DateTime @default(now())
  createdAt             DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([date])
}
